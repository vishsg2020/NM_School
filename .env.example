# Copy to .env and fill in. Never commit .env.

# HTTP port
PORT=3000

# SQLite database file. Put it on a persistent disk in production.
DATABASE_PATH=./data/nm-school.db

# School timezone used for "today", overdue checks and class dates.
APP_TZ=Asia/Kolkata

# Set to "production" when served over HTTPS (makes the session cookie Secure).
NODE_ENV=development

# If running behind a reverse proxy / platform load balancer, set to 1 so client IPs are correct.
# TRUST_PROXY=1

# Session length in hours.
SESSION_HOURS=12

# First run only: creates the first Manager when the database has no users.
# Remove INITIAL_MANAGER_PASSWORD after the first start.
INITIAL_MANAGER_NAME=Manager
INITIAL_MANAGER_EMAIL=
INITIAL_MANAGER_PASSWORD=

# Backups (npm run backup)
BACKUP_DIR=./backups
BACKUP_KEEP=30
