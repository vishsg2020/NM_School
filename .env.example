# ── On Netlify ─────────────────────────────────────────────────────────────
# Set these in Netlify: Project configuration → Environment variables (see README).

# Supabase → Connect → Transaction pooler (port 6543). Needed by builds (migrations) and functions.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-2.pooler.supabase.com:6543/postgres

# Optional: Supabase root certificate (PEM text) for verified TLS. Easier: commit it as db/ca.crt instead.
# DATABASE_CA_CERT=

# First deploy only: creates the first Manager when the database has no users.
# Delete INITIAL_MANAGER_PASSWORD from Netlify once you have signed in.
INITIAL_MANAGER_NAME=Manager
INITIAL_MANAGER_EMAIL=
INITIAL_MANAGER_PASSWORD=

# Do NOT set NODE_ENV=production on Netlify: the build would skip dev dependencies and the test step would fail.
# The app detects Netlify itself and makes the session cookie HTTPS-only.

# Optional
# APP_TZ=Asia/Kolkata        (already set in netlify.toml)
# SESSION_HOURS=12

# ── Local development only (copy this file to .env) ───────────────────────
# PORT=3000
# Leave DATABASE_URL unset (comment it out) to use the built-in local Postgres stored in ./data/pg.
# LOCAL_DB_DIR=./data/pg
# BACKUP_DIR=./backups
# BACKUP_KEEP=30
